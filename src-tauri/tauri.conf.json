{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pdeffy",
  "version": "2.0.0",
  "identifier": "com.reindal.pdeffy",
  "build": {
    "beforeDevCommand": "npm run dev:vite",
    "beforeBuildCommand": "npm run build:vite",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Pdeffy 2.0.0 — Reindal",
        "width": 1280,
        "height": 800,
        "maximized": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["pdf"],
        "mimeType": "application/pdf",
        "contentTypes": ["com.adobe.pdf"],
        "name": "PDF Document",
        "description": "PDF Document",
        "role": "Viewer",
        "rank": "Alternate"
      }
    ],
    "resources": {
      "../resources/ghostscript/win": "ghostscript/win",
      "resources/pdf-document.ico": "pdf-document.ico"
    },
    "linux": {
      "deb": {
        "desktopTemplate": "linux/pdeffy.desktop.hbs"
      },
      "rpm": {
        "desktopTemplate": "linux/pdeffy.desktop.hbs"
      }
    },
    "windows": {
      "nsis": {
        "installerHooks": "./windows/installer-hooks.nsh"
      }
    }
  }
}
